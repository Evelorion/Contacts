<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 颜色 token。深色值在 values-night/m3_colors.xml，两份的 name 必须一一对应。

  命名用 M3 官方语义名（primary / surface_container_high / on_surface_variant…），
  不用 "purple_500" 这类描述颜色本身的名字 —— 换配色时语义名不用改，
  描述性的名字会立刻变成谎话。

  布局里**不要直接引用这些 @color**，要用 ?attr/colorPrimary 这类属性，
  否则用户切换配色时换不掉。见 m3_palettes.xml 顶部的说明。
-->
<resources>

    <color name="m3_primary">#6750A4</color>
    <color name="m3_on_primary">#FFFFFF</color>
    <color name="m3_primary_container">#EADDFF</color>
    <color name="m3_on_primary_container">#21005D</color>
    <color name="m3_secondary_container">#E8DEF8</color>
    <color name="m3_on_secondary_container">#1D192B</color>
    <color name="m3_tertiary_container">#FFD8E4</color>
    <color name="m3_on_tertiary_container">#31111D</color>
    <color name="m3_surface">#FEF7FF</color>
    <color name="m3_surface_container_low">#F7F2FA</color>
    <color name="m3_surface_container">#F3EDF7</color>
    <color name="m3_surface_container_high">#ECE6F0</color>
    <color name="m3_surface_container_highest">#E6E0E9</color>
    <color name="m3_on_surface">#1D1B20</color>
    <color name="m3_on_surface_variant">#49454F</color>
    <color name="m3_outline">#79747E</color>
    <color name="m3_outline_variant">#CAC4D0</color>
    <color name="m3_error">#B3261E</color>

    <!-- 头像底色轮转。按联系人 id 取模，保证同一个人每次进来颜色一致。
         都是 M3 的 40 号色阶，配白字对比度足够。 -->
    <color name="m3_avatar_0">#6750A4</color>
    <color name="m3_avatar_1">#7D5260</color>
    <color name="m3_avatar_2">#386A20</color>
    <color name="m3_avatar_3">#00639B</color>
    <color name="m3_avatar_4">#8F4C38</color>
    <color name="m3_avatar_5">#4F378B</color>
    <color name="m3_avatar_6">#006A6A</color>
    <color name="m3_avatar_7">#7B5800</color>

</resources>
