<?xml version="1.0" encoding="utf-8"?>
<!--
  全屏搜索页。

  M3 的 docked search bar 模式：列表页放一个"看起来能输入"的条，
  点了之后进这一页真正输入。好处是列表页完全不用处理输入法弹起时的布局变化。

  三种状态互斥：
    没输入      → 最近搜索
    有结果      → 结果列表
    有输入无结果 → 空态 + 新建入口
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- 搜索条。和主页那条外观一致（56 高、28 圆角、surfaceContainerHigh），
         过渡时不会跳一下。 -->
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/m3_search_bar_height"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/m3_bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/search_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/m3_bg_circle_ripple"
            android:contentDescription="@string/back"
            android:padding="11dp"
            android:src="@drawable/ic_m3_arrow_back" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/m3_search_input_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/search_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/m3_bg_circle_ripple"
            android:contentDescription="@string/m3_search_clear"
            android:padding="11dp"
            android:src="@drawable/ic_m3_close"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- ─────────────── 最近搜索 ─────────────── -->

    <LinearLayout
        android:id="@+id/search_recent_holder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:text="@string/m3_search_recent"
            android:textAppearance="@style/TextAppearance.Contacts.SectionHeader"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 历史词由代码填充 -->
        <LinearLayout
            android:id="@+id/search_recent_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- ─────────────── 结果列表 ─────────────── -->

    <TextView
        android:id="@+id/search_result_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:textAppearance="@style/TextAppearance.Contacts.BodySmall"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar"
        tools:text="3 个结果"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_result_count"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- ─────────────── 空态 ─────────────── -->

    <LinearLayout
        android:id="@+id/search_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="64dp"
        android:paddingEnd="40dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/m3_bg_avatar_squircle"
            android:backgroundTint="?attr/colorSurfaceContainerHigh">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_m3_search_off" />
        </FrameLayout>

        <TextView
            android:id="@+id/search_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="19sp"
            tools:text="没有找到「张」" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/m3_search_empty_desc"
            android:textAppearance="@style/TextAppearance.Contacts.BodySmall"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/search_empty_create"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/m3_bg_tag"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_m3_person_add"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/create_new_contact"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
