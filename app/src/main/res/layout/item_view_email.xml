<?xml version="1.0" encoding="utf-8"?>
<!--
  详情页信息行 · M3

  值在上、类型标签在下 —— 和"标签在上"的老做法相反。这是 M3 列表的规范：
  用户扫视时先看到的应该是内容本身（号码），而不是它是什么类型（手机）。

  最小高度 64dp 满足 M3 的触摸目标要求；背景是透明 ripple，
  底色由外面那张卡片提供。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contact_email_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/m3_bg_card_row"
    android:minHeight="64dp"
    android:paddingStart="@dimen/m3_card_row_padding_horizontal"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/m3_card_row_padding_horizontal"
    android:paddingBottom="12dp">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/contact_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Contacts.BodyLarge" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/contact_email_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/contact_email"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Contacts.LabelSmall" />

</RelativeLayout>
