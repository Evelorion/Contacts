<?xml version="1.0" encoding="utf-8"?>
<!--
  收藏页的格子 · M3

  设计稿：26dp 圆角卡，52dp 头像 + 姓名 + 号码 + 两个小动作按钮。
  这里做前三样；动作按钮需要 Adapter 配合接事件，暂时不放
  ——摆一个点不动的按钮比不摆更糟。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_contact_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/m3_bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/m3_bg_card_row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/item_contact_image"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/item_contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Contacts.BodyLarge"
            tools:text="林晚" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/item_contact_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Contacts.BodySmall"
            tools:text="138 0013 8000" />
    </LinearLayout>

    <!-- 旧布局里的 drag_handle_icon，Adapter 仍会 findViewById -->
    <View
        android:id="@+id/drag_handle_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
