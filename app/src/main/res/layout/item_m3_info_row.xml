<?xml version="1.0" encoding="utf-8"?>
<!--
  详情页信息卡里的一行：图标 + 值 + 标签 + 可选的复制按钮。

  值在上、标签在下 —— 和常见的"标签在上"相反。这是 M3 列表的做法：
  用户扫视时先看到的应该是内容本身（号码），而不是它是什么类型（手机）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/info_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/m3_bg_card_row"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:paddingStart="@dimen/m3_card_row_padding_horizontal"
    android:paddingTop="@dimen/m3_card_row_padding_vertical"
    android:paddingEnd="@dimen/m3_card_row_padding_horizontal"
    android:paddingBottom="@dimen/m3_card_row_padding_vertical">

    <ImageView
        android:id="@+id/info_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/info_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/m3_card_row_gap"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Contacts.BodyLarge"
        app:layout_constraintBottom_toTopOf="@+id/info_label"
        app:layout_constraintEnd_toStartOf="@+id/info_copy"
        app:layout_constraintStart_toEndOf="@+id/info_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="138 0013 8000" />

    <TextView
        android:id="@+id/info_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/m3_card_row_gap"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Contacts.LabelSmall"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/info_copy"
        app:layout_constraintStart_toEndOf="@+id/info_icon"
        app:layout_constraintTop_toBottomOf="@+id/info_value"
        tools:text="手机" />

    <ImageView
        android:id="@+id/info_copy"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/m3_bg_circle_ripple"
        android:contentDescription="@string/m3_copied"
        android:padding="10dp"
        android:src="@drawable/ic_m3_content_copy"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
